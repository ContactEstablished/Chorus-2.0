# LF everywhere, so editors and tools never produce whole-file line-ending diffs.
* text=auto eol=lf

# Windows scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wav binary
